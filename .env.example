# Adresse de shop-api pour `pnpm dev` (lue uniquement par src/shared/config)
BACKEND_API_URL=http://localhost:8080
# Port local sur lequel le compose publie shop-web
WEB_PORT=3000
# Adresse de shop-api vue depuis le conteneur (shop-api tourne sur le poste)
COMPOSE_BACKEND_API_URL=http://host.docker.internal:8080
